<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Unidad.Adapter</AssemblyName>
    <SourceDir>Packages/com.unidad.unity/Runtime</SourceDir>
  </PropertyGroup>
  <!-- Input System types come only from the refpack (U-58); until one exists the Input folder is not compiled. -->
  <ItemGroup Condition="'$(HasRefPack)'!='true'">
    <SourceExclude Include="$(RepoRoot)$(SourceDir)/Input/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Unidad.Core/Unidad.Core.csproj" />
    <ProjectReference Include="../Unidad.Launch/Unidad.Launch.csproj" />
    <ProjectReference Include="../Unidad.Flow/Unidad.Flow.csproj" />
    <ProjectReference Include="../Unidad.Text/Unidad.Text.csproj" />
    <ProjectReference Include="../Unidad.Save/Unidad.Save.csproj" />
    <ProjectReference Include="../Unidad.Audio/Unidad.Audio.csproj" />
  </ItemGroup>
</Project>
